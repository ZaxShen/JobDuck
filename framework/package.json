{
  "name": "jobduck",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "Agent-run job search: a local SQLite store and CLI that your coding agent drives.",
  "keywords": [
    "job-search",
    "mcp",
    "agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "sqlite",
    "applications"
  ],
  "license": "MIT",
  "author": "Zax Shen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaxShen/JobDuck.git",
    "directory": "framework"
  },
  "homepage": "https://github.com/ZaxShen/JobDuck#readme",
  "bugs": "https://github.com/ZaxShen/JobDuck/issues",
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/cli.ts --outfile dist/jobduck",
    "build:all": "bash scripts/build-all.sh",
    "smoke": "bash scripts/smoke.sh",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.1",
    "smol-toml": "^1.4.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "bun-types": "^1.3.4",
    "typescript": "^5.9.3"
  }
}
